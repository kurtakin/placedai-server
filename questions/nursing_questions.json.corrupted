  "questions": [
    {
      "id": "nur_b_001",
      "category": "behavioral",
      "seniority": [
        "entry",
        "mid",
        "senior"
      ],
      "text": "Tell me about yourself and your nursing background.",
      "answer_framework": {
        "structure": "Framework",
        "key_points": [
          "Open with licence and setting: RN or BSN, years of experience, unit type (med-surg, ICU, ED, tele, LTC) and typical patient ratio",
          "Name the patient population and acuity you handle, plus certifications (BLS, ACLS, PALS, CCRN, TNCC, NIHSS)",
          "Give one concrete strength with evidence: preceptor for new grads, unit fall rate improvement, charge nurse rotation",
          "Close by tying your background to this unit and why you applied here"
        ],
        "strong_answer_signals": [
          "Specific ratios and acuity: caring for 5 med-surg patients or 2 ICU patients shows the interviewer your real scope",
          "EMR fluency named directly (Epic, Cerner, Meditech) because onboarding cost is a hiring concern",
          "A measurable contribution rather than a list of duties"
        ],
        "avoid": [
          "Reciting your resume chronologically from nursing school forward",
          "Personal life details, commute, or family circumstances",
          "Running past two minutes, which signals you cannot prioritise under pressure"
        ]
      }
    },
    {
      "id": "nur_b_002",
      "category": "behavioral",
      "seniority": [
        "entry",
        "mid",
        "senior"
      ],
      "text": "Tell me about a time you caught a medication error before it reached the patient.",
      "answer_framework": {
        "structure": "STAR",
        "key_points": [
          "Name the catch point: order verification, MAR review, barcode scan alert, or independent double check on a high alert drug",
          "State what was wrong: wrong dose, wrong route, wrong patient, duplicate therapy, or an allergy conflict",
          "Describe escalation: you held the dose, contacted the prescriber or pharmacy, and documented",
          "Close with the system fix: variance report filed, order set corrected, or a change you suggested"
        ],
        "strong_answer_signals": [
          "Treats the five rights as an active habit, not a slogan",
          "Files a safety or variance report and frames it as system improvement rather than blaming a person",
          "Mentions high alert medications by name (insulin, heparin, opioids, potassium) and the double check policy"
        ],
        "avoid": [
          "Naming or blaming the prescriber or pharmacist",
          "Saying you gave the dose and monitored the patient instead of holding it",
          "A story with no reporting step, which reads as a near miss that was buried"
        ]
      }
    },
    {
      "id": "nur_b_003",
      "category": "behavioral",
      "seniority": [
        "mid",
        "senior"
      ],
      "text": "Describe a time you disagreed with a physician about a patient's plan of care.",
      "answer_framework": {
        "structure": "STAR",
        "key_points": [
          "Ground the disagreement in assessment data: vitals, labs, trends, or a change you observed at the bedside",
          "Show you used a structured tool: SBAR, or a graded assertiveness phrase such as I am concerned, I am uncomfortable, this is a safety issue",
          "Describe the escalation chain you followed if the first conversation did not resolve it: charge nurse, rapid response, nursing supervisor, attending",
          "End with the patient outcome and the professional relationship afterwards"
        ],
        "strong_answer_signals": [
          "Frames the nurse role as patient advocate with an obligation to escalate, not as insubordination",
          "Knows the chain of command and names it, which tells the interviewer you will use it on their unit",
          "Keeps a collaborative tone: the goal was the patient, not winning"
        ],
        "avoid": [
          "A story where you simply followed an order you believed was unsafe",
          "Emotional or personal framing of the physician",
          "Escalating past the chain of command as a first move"
        ]
      }
    },
    {
      "id": "nur_b_004",
      "category": "behavioral",
      "seniority": [
        "entry",
        "mid",
        "senior"
      ],
      "text": "Tell me about a time you advocated for a patient and the outcome.",
      "answer_framework": {
        "structure": "STAR",
        "key_points": [
          "Identify the patient advocacy: cultural/linguistic barrier, care gap, patient concern, or safety issue",
          "Show your actions: bridging interpreter, educating provider, clarifying concerns, or patient navigation",
          "Describe the impact: improved treatment plan, better patient understanding, reduced anxiety, or safety improvement",
          "Conclude with the professional lesson: always put the patient first, the value of cultural competence, or the importance of voice"
        ],
        "strong_answer_signals": [
          "Names specific barriers (language, health literacy, cultural) and concrete solutions (interpreter, cultural broker)",
          "Shows direct patient contact and measurable impact (patient satisfaction, treatment adherence)",
          "Uses the word "advocate" and ties it to nursing scope of practice"
        ],
        "avoid": [
          "A story where advocacy was passive or indirect",
          "Only mentioning patient rights without specific actions taken",
          "Talking about advocacy without clear patient outcome"
        ]
      }
    },
    {
      "id": "nur_b_005",
      "category": "behavioral",
      "seniority": [
        "entry",
        "mid"
      ],
      "text": "Describe your experience with electronic medical records (EMR) and patient safety.",
      "answer_framework": {
        "structure": "STAR",
        "key_points": [
          "Set the context: specific unit/setting and EMR system (Epic, Cerner, Meditech)",
          "Describe your actions: alerts you implemented, order sets, discharge summaries, or patient portal use",
          "Share outcomes: reduced medication errors, improved efficiency, better patient engagement",
          "Conclude with system improvements: documentation changes, training updates, or process refinements"
        ],
        "strong_answer_signals": [
          "Names specific EMR features (SCBARS, medication administration records)",
          "Quantifies impact (reduced errors by X%, saved Y minutes per shift)",
          "Connects technology directly to patient safety outcomes"
        ],
        "avoid": [
          "Only describing technical features without patient safety impact",
          "Mentioning EMR issues without solutions or improvements",
          "Vague statements about "EMRs are helpful" without specific examples"
        ]
      }
    },
    {
      "id": "nur_b_006",
      "category": "situational",
      "seniority": [
        "entry",
        "mid",
        "senior"
      ],
      "text": "What would you do if a patient refused a necessary medication due to religious beliefs?",
      "answer_framework": {
        "structure": "Framework",
        "key_points": [
          "Assess the situation: medication necessity vs. patient autonomy",
          "Explore respectfully: understand specific religious beliefs, discuss alternatives",
          "Consult resources: ethics committee, hospital policy, case management",
          "Document thoroughly: refusal, alternatives offered, clinical reasoning",
          "Ensure patient safety: emergency planning, family notification"
        ],
        "strong_answer_signals": [
          "Knows institutional policies for religious refusals (how to handle Catholic Eucharist, Jehovah Witness blood)",
          "Balances patient autonomy with nursing responsibility for safety",
          "Uses therapeutic communication and cultural humility"
        ],
        "avoid": [
          "Ignoring patient autonomy",
          "Not consulting appropriate resources",
          "Forcing medication against religious beliefs"
        ]
      }
    },
    {
      "id": "nur_b_007",
      "category": "situational",
      "seniority": [
        "entry",
        "mid"
      ],
      "text": "How would you handle a situation where a coworker is consistently late for their shift and covers for themselves when patients are short-staffed?",
      "answer_framework": {
        "structure": "Framework",
        "key_points": [
          "Observe facts: impact on patient care, frequency, severity",
          "Address privately: speak with coworker, understand underlying issues",
          "Document concerns: formal reports if needed",
          "Ensure patient safety: adjust assignments, notify supervisor",
          "Follow chain of command: HR, unit leadership, administration"
        ],
        "strong_answer_signals": [
          "Shows balanced approach: supportive but professional",
          "Knows institutional policies for tardiness and patient safety",
          "Protects both patient and coworker interests"
        ],
        "avoid": [
          "Publicly shaming the coworker",
          "Ignoring the issue for convenience",
          "Blaming the employee without understanding context"
        ]
      }
    },
    {
      "id": "nur_b_008",
      "category": "technical",
      "seniority": [
        "mid",
        "senior"
      ],
      "text": "Explain the process of hand hygiene before patient contact. What steps are most important?",
      "answer_framework": {
        "structure": "Framework",
        "key_points": [
          "Identify all hand hygiene moments: before patient contact, after patient contact, after exposure to body fluids",
          "Describe WHO 5 moments: before touching patient, before clean/aseptic procedure, after exposure to body fluids, after patient contact, after touching patient"
        ],
        "strong_answer_signals": [
          "Names specific techniques: surgical hand scrub vs. alcoholic hand sanitizer",
          "Quantifies impact: 85-90% of healthcare-associated infections prevented by hand hygiene",
          "Describes proper timing (20-30 seconds for hand sanitizer, 2 minutes for surgical scrub)"
        ],
        "avoid": [
          "Only mentioning hand sanitizer without discussing surgical hand washing",
          "Not including all WHO 5 moments",
          "Providing vague or incomplete process descriptions"
        ]
      }
    },
    {
      "id": "nur_b_009",
      "category": "technical",
      "seniority": [
        "entry",
        "mid",
        "senior"
      ],
      "text": "Describe the signs and symptoms of sepsis. How would you recognize it early?",
      "answer_framework": {
        "structure": "Framework",
        "key_points": [
          "Identify SIRS criteria: temperature >100.4°F or <96°F, heart rate >90, respiratory rate >20, or WBC abnormalities",
          "Describe qSOFA: altered mental status, SBP <100, respiratory rate >22",
          "Explain early warning scores: Rapid Response Team, MEWS",
          "Share monitoring strategies: vital signs every hour on high-risk units"
        ],n        "strong_answer_signals": [
          "Names all four SIRS criteria",
          "Differentiates SIRS from qSOFA and sepsis protocols",
          "Describes specific vital sign thresholds and timing"
        ],
        "avoid": [
          "Only mentioning "sepsis signs" without specific criteria",
          "Not distinguishing SIRS from sepsis",
          "Vague descriptions without measurable thresholds"
        ]
      }
    },
    {
      "id": "nur_b_010",
      "category": "manager",
      "seniority": [
        "mid",
        "senior",
        "manager"
      ],
      "text": "How do you manage staff when there is a high patient load and low staffing?",
      "answer_framework": {
        "structure": "STAR",
        "key_points": [
          "Assess the situation: patient acuity, staff skills, unit capacity",
          "Develop solutions: float staff, reassign tasks, call for relief",
          "Communicate clearly: inform charge nurse, department leadership",
          "Monitor effectiveness: patient outcomes, staff satisfaction"
        ],n        "strong_answer_signals": [
          "Shows balanced approach: patient safety + staff well-being",
          "Knows unit-specific resources and emergency protocols",
          "Demonstrates leadership and delegation skills"
        ],
        "avoid": [
          "Ignoring patient safety for staffing convenience",
          "Blaming staff for staffing issues",
          "Not involving leadership or supervisors"
        ]
      }
    },
    {
      "id": "nur_b_011",
      "category": "manager",
      "seniority": [
        "manager",
        "mid",
        "senior"
      ],
      "text": "Tell me about a time you had to handle a difficult conversation with a family member.",
      "answer_framework": {
        "structure": "STAR",
        "key_points": [
          "Set the stage: understand family perspective, identify concerns",
          "Lead with empathy: active listening, acknowledge emotions",
          "Communicate clearly: medical status, care plans, next steps",
          "Handle questions: honestly, but hope-filled",
          "Document thoroughly: family meeting notes, follow-up plans"
        ],
        "strong_answer_signals": [
          "Shows cultural humility: understands different communication styles",
          "Balances honesty with hope and therapeutic communication",
          "Follows institutional policies for difficult family conversations"
        ],
        "avoid": [
          "Being overly clinical or detached",
          "Giving false hope or misleading information",
          "Not involving interpreters or cultural brokers when needed"
        ]
      }
    },
    {
      "id": "nur_b_012",
      "category": "motivation",
      "seniority": [
        "entry",
        "mid",
        "senior"
      ],
      "text": "Why did you choose nursing as a career? What drives you?",
      "answer_framework": {
        "structure": "Framework",
        "key_points": [
          "Personal motivation: helping others, science background, family influence",
          "Professional fulfillment: making a difference, continuous learning",
          "Values alignment: compassion, advocacy, teamwork",
          "Future impact: shaping healthcare, influencing policy"
        ],
        "strong_answer_signals": [
          "Shows genuine passion, not superficial answers",
          "Connects to specific experiences or influences",
          "Demonstrates understanding of nursing's challenges and rewards"
        ],
        "avoid": [
          "Stating "I always wanted to help people" without details",
          "Only mentioning high salary or prestige",
          "Generic answers that could apply to many professions"
        ]
      }
    }
  ],
