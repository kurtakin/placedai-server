    {
      "id": "tea_001",
      "text": "Tell me about a time you had a student who was disengaged or struggling. How did you help them?",
      "category": "behavioral",
      "seniority": [
        "entry",
        "mid",
        "senior"
      ],
      "answer_framework": {
        "structure": "STAR",
        "key_points": [
          "Identified the root cause of disengagement",
          "Tailored instruction and support to the student's needs",
          "Engaged the student or family in the solution",
          "Measured progress and adjusted"
        ],
        "strong_answer_signals": [
          "Specific student-centered strategies used",
          "Family or support team engaged",
          "Growth mindset demonstrated"
        ],
        "avoid": [
          "Giving up on the student",
          "Using one-size-fits-all approach",
          "Not analyzing root cause"
        ]
      }
    },
    {
